{
  "name": "@audio/pitch",
  "version": "2.2.0",
  "type": "module",
  "description": "Pitch detection — umbrella for @audio/pitch-* atoms (YIN, pYIN, McLeod, HPS, cepstrum, SWIPE, autocorrelation, AMDF)",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./members/*.d.ts",
      "default": "./members/*.js"
    }
  },
  "files": [
    "index.js",
    "*.d.ts",
    "members/"
  ],
  "scripts": {
    "test": "node test.js",
    "test:all": "npm test --workspaces --if-present && npm test",
    "publish:all": "npm publish --workspaces && npm publish",
    "members": "node scripts/members.js",
    "prepublishOnly": "node scripts/members.js --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/pitch.git"
  },
  "keywords": [
    "pitch",
    "pitch-detection",
    "yin",
    "pyin",
    "mcleod",
    "mpm",
    "autocorrelation",
    "amdf",
    "hps",
    "cepstrum",
    "swipe",
    "chroma",
    "pcp",
    "nnls",
    "chord",
    "chord-detection",
    "key-detection",
    "krumhansl",
    "frequency",
    "f0",
    "fundamental",
    "audio",
    "dsp",
    "signal-processing"
  ],
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/audiojs/pitch/issues"
  },
  "homepage": "https://github.com/audiojs/pitch#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@audio/pitch-yin": "^1.0.6",
    "@audio/pitch-mcleod": "^1.0.2",
    "@audio/pitch-pyin": "^2.1.0",
    "@audio/pitch-hps": "^1.0.2",
    "@audio/pitch-cepstrum": "^1.0.2",
    "@audio/pitch-swipe": "^1.0.2",
    "@audio/pitch-autocorrelation": "^1.0.2",
    "@audio/pitch-amdf": "^1.0.2"
  },
  "devDependencies": {
    "tst": "^9.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "index.js",
  "workspaces": [
    "packages/*"
  ],
  "funding": "https://github.com/sponsors/audiojs",
  "types": "./index.d.ts"
}
