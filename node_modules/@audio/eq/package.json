{
  "name": "@audio/eq",
  "version": "1.1.0",
  "type": "module",
  "sideEffects": false,
  "description": "Equalization & tone shaping — umbrella for @audio/eq-* atoms (shelves, parametric, graphic, baxandall, tilt, crossover)",
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./members/*.d.ts",
      "default": "./members/*.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "members/"
  ],
  "workspaces": [
    "packages/*"
  ],
  "keywords": [
    "audio",
    "eq",
    "equalizer",
    "dsp",
    "parametric",
    "graphic"
  ],
  "license": "MIT",
  "dependencies": {
    "@audio/eq-highshelf": "^1.1.2",
    "@audio/eq-lowshelf": "^1.1.2",
    "@audio/eq-parametric": "^1.1.2",
    "@audio/eq-graphic": "^1.2.4",
    "@audio/eq-baxandall": "^1.2.3",
    "@audio/eq-tilt": "^1.2.3",
    "@audio/eq-crossover": "^1.0.2",
    "@audio/eq-fir": "^1.0.2",
    "@audio/eq-dynamic": "^1.2.3",
    "@audio/eq-fit": "^0.1.1"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "scripts": {
    "test": "node test.js",
    "test:all": "npm test --workspaces --if-present && npm test",
    "publish:all": "npm publish --workspaces && npm publish",
    "members": "node scripts/members.js",
    "prepublishOnly": "node scripts/members.js --check"
  },
  "types": "index.d.ts",
  "devDependencies": {
    "tst": "^9.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/eq.git"
  },
  "funding": "https://github.com/sponsors/audiojs"
}
