    "audio",
    "dsp",
    "eq",
    "fir",
    "linear-phase",
    "firequalizer"
  ],
  "license": "MIT",
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
