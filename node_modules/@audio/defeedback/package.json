{
  "name": "@audio/defeedback",
  "version": "1.3.0",
  "type": "module",
  "sideEffects": false,
  "description": "Adaptive feedback suppression — umbrella for @audio/defeedback-* atoms (analyzer, tracker, notch bank)",
  "workspaces": [
    "packages/*"
  ],
  "keywords": [
    "audio",
    "dsp",
    "feedback",
    "howling",
    "notch",
    "live-sound"
  ],
  "license": "MIT",
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "engines": {
    "node": ">=18"
  },
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./audio": {
      "types": "./audio.d.ts",
      "default": "./audio.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./members/*.d.ts",
      "default": "./members/*.js"
    }
  },
  "files": [
    "index.js",
    "audio.js",
    "*.d.ts",
    "members/"
  ],
  "scripts": {
    "test": "node test.js",
    "test:all": "npm test --workspaces --if-present && npm test",
    "publish:all": "npm publish --workspaces && npm publish",
    "members": "node scripts/members.js",
    "prepublishOnly": "node scripts/members.js --check"
  },
  "dependencies": {
    "@audio/defeedback-analyzer": "^1.0.1",
    "@audio/defeedback-tracker": "^1.0.1",
    "@audio/defeedback-notchbank": "^1.2.0"
  },
  "devDependencies": {
    "tst": "^9.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "audio": "./audio.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/defeedback.git"
  },
  "funding": "https://github.com/sponsors/audiojs",
  "types": "./index.d.ts"
}
