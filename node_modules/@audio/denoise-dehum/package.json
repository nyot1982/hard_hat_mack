{
  "name": "@audio/denoise-dehum",
  "version": "0.7.1",
  "description": "Mains hum, buzz and steady tone removal: the mains phase tracked, every line subtracted along it, then each tone held through the take (a whine, a test tone) found and subtracted; nothing found, no change",
  "type": "module",
  "sideEffects": false,
  "main": "dehum.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./dehum.js"
    },
    "./package.json": "./package.json",
    "./audio": {
      "types": "./audio.d.ts",
      "default": "./audio.js"
    }
  },
  "files": [
    "dehum.js",
    "audio.js",
    "index.d.ts",
    "audio.d.ts"
  ],
  "dependencies": {
    "@audio/biquad": "^1.1.0"
  },
  "keywords": [
    "audio",
    "dsp",
    "denoise",
    "restoration",
    "dehum"
  ],
  "license": "MIT",
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/denoise.git",
    "directory": "packages/denoise-dehum"
  },
  "homepage": "https://github.com/audiojs/denoise/tree/main/packages/denoise-dehum",
  "bugs": {
    "url": "https://github.com/audiojs/denoise/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "index.d.ts",
  "audio": "./audio.js",
  "funding": "https://github.com/sponsors/audiojs"
}
