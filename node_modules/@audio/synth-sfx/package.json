{
  "name": "@audio/synth-sfx",
  "version": "1.1.4",
  "description": "Game/UI sound effects generator — ZZFX / ChipTone class parameterized synthesis",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "audio",
    "synth",
    "sfx",
    "zzfx",
    "chiptune"
  ],
  "license": "MIT",
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "engines": {
    "node": ">=18"
  },
  "main": "sfx.js",
  "exports": {
    ".": "./sfx.js",
    "./audio": {
      "types": "./audio.d.ts",
      "default": "./audio.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "sfx.js",
    "sfx.d.ts",
    "audio.js",
    "audio.d.ts"
  ],
  "types": "sfx.d.ts",
  "dependencies": {
    "@audio/synth-osc": "^1.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "audio": "./audio.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/synth.git",
    "directory": "packages/synth-sfx"
  },
  "funding": "https://github.com/sponsors/audiojs"
}
